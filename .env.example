# ── App ───────────────────────────────────────────────────────────────────
APP_NAME="BBC News Classifier API"
APP_VERSION="1.0.0"
DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]

# ── Active model backends ─────────────────────────────────────────────────
# Comma-separated list of backends to load at startup.
# Supported values: tfidf, bert
#   ACTIVE_MODELS=tfidf           → TF-IDF only (lightweight, no GPU needed)
#   ACTIVE_MODELS=bert            → BERT only (requires torch + transformers)
#   ACTIVE_MODELS=tfidf,bert      → both (higher memory; first entry = default)
ACTIVE_MODELS=tfidf,bert

# ── Common inference settings ─────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.5
MAX_TEXT_LENGTH=10000

# ── TF-IDF model artifacts ────────────────────────────────────────────────
# Place trained joblib files in the directory below:
TFIDF_MODEL_DIR=models/tfidf
TFIDF_MODEL_NAME=news_classifier.pkl
TFIDF_VECTORIZER_NAME=tfidf_vectorizer.pkl
TFIDF_LABEL_ENCODER_NAME=label_encoder.pkl

# ── BERT model ────────────────────────────────────────────────────────────
# Option A — fine-tuned local checkpoint:
#   Place checkpoint dir at: models/bert/<BERT_MODEL_NAME>/
# Option B — HuggingFace Hub (requires internet on first run):
#   BERT_MODEL_NAME=bert-base-uncased
BERT_MODEL_DIR=models/bert
BERT_MODEL_NAME=bbc-bert-finetuned
BERT_MAX_LENGTH=512
BERT_DEVICE=cpu    # cpu | cuda | mps

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json    # json (production) | text (local dev)

# ── Ngrok Tunnel ──────────────────────────────────────────────────────────
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=3DqO4dgYlXllhCt74uYMlbN7U4v_5W5TUVG9uPU7e8QBqND9U